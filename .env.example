# Mentoria Hub — environment template. Copy to .env.local and fill in.
# (.env.local is git-ignored; this file is committed as documentation.)

# Dev mock auth: "true" lets the app run with no Supabase (demo de-risking).
# Set "false" in production / once real auth is configured.
NEXT_PUBLIC_DEV_AUTH=true

# Public deployment URL for metadata, OG, and OAuth setup notes.
NEXT_PUBLIC_SITE_URL=https://<your-production-domain>

# Supabase — from Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Phase 5 (AI)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Phase 7 demo priming. Sign these accounts in once, copy their auth user ids,
# then run: npm run demo:prime
# DEMO_FRESH_STUDENT_ID=
# DEMO_PRIMED_STUDENT_ID=
# DEMO_ADMIN_ID=
