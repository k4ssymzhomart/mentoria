# Mentoria Hub — environment template. Copy to .env.local and fill in.
# (.env.local is git-ignored; this file is committed as documentation.)

# Dev mock auth: "true" lets the app run with no Supabase (demo de-risking).
# Set "false" in production / once real auth is configured.
NEXT_PUBLIC_DEV_AUTH=true

# Supabase — from Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Phase 5 (AI)
# ANTHROPIC_API_KEY=
